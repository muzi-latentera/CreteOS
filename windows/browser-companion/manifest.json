{
  "manifest_version": 3,
  "name": "CreteOS Luna Companion",
  "version": "0.1.1",
  "description": "Reports Luna stream start/end to CreteOS on this device. No account or cookie access.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1:59265/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://luna.amazon.co.uk/*",
        "https://luna.amazon.com/*"
      ],
      "js": [
        "observer.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
